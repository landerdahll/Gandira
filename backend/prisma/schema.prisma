generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  PRODUCER
  STAFF
  ADMIN
}

enum PlatformRole {
  MEMBER
  SUPER_ADMIN
}

enum OrganizationRole {
  ORG_ADMIN
  PRODUCER
  STAFF
}

enum OrganizationMemberStatus {
  ACTIVE
  INACTIVE
}

enum OrganizationInvitationRole {
  ORG_ADMIN
  PRODUCER
  STAFF
}

enum OrganizationInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  FINISHED
}

enum TicketType {
  GENERAL
  VIP
  BACKSTAGE
  ONLINE
}

enum BatchStatus {
  ACTIVE
  SOLD_OUT
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  REFUND_PENDING
  CANCELLED
  REFUNDED
  REFUND_FAILED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
  ABACATEPAY
}

enum TicketStatus {
  ACTIVE
  TRANSFER_PENDING
  USED
  CANCELLED
  TRANSFERRED
}

enum TicketTransferStatus {
  PENDING_REGISTRATION
  PENDING_EMAIL_VERIFICATION
  COMPLETED
  CANCELLED
  EXPIRED
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  RETRY
  FAILED
}

enum CheckInMethod {
  QR_CODE
  MANUAL
  AT_DOOR
}

enum ClubBenefitUsageStatus {
  RESERVED
  CONFIRMED
  RELEASED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  password     String
  name         String
  phone        String?
  cpf          String?      @unique
  role         Role         @default(CUSTOMER)
  platformRole PlatformRole @default(MEMBER)
  gender       Gender?
  birthDate    DateTime?
  avatarUrl    String?
  isVerified   Boolean      @default(false)
  isActive     Boolean      @default(true)

  events                      Event[]
  orders                      Order[]
  checkIns                    CheckIn[]                @relation("StaffCheckIns")
  refreshTokens               RefreshToken[]
  auditLogs                   AuditLog[]
  passwordResetTokens         PasswordResetToken[]
  emailVerificationTokens     EmailVerificationToken[]
  ownedTickets                Ticket[]                 @relation("TicketOwner")
  sentTicketTransfers         TicketTransfer[]         @relation("TransferSender")
  receivedTicketTransfers     TicketTransfer[]         @relation("TransferRecipient")
  organizationMemberships     OrganizationMember[]
  organizationInvitationsSent OrganizationInvitation[] @relation("OrganizationInvitationsSent")
  organizationInvitationsAccepted OrganizationInvitation[] @relation("OrganizationInvitationsAccepted")
  verificationEmailLastSentAt DateTime?
  passwordResetLastSentAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([cpf])
}

model Organization {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  isActive       Boolean @default(true)
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  website        String?
  instagram      String?

  members OrganizationMember[]
  invitations OrganizationInvitation[]
  events  Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model OrganizationMember {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationRole
  status         OrganizationMemberStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, role, status])
}

model OrganizationInvitation {
  id               String                       @id @default(cuid())
  organizationId   String
  organization     Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email            String
  role             OrganizationInvitationRole
  status           OrganizationInvitationStatus @default(PENDING)
  tokenHash        String                       @unique
  activeKey        String?                      @unique
  customMessage    String?                      @db.VarChar(250)
  invitedByUserId  String
  invitedBy        User                         @relation("OrganizationInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedByUserId String?
  acceptedBy       User?                        @relation("OrganizationInvitationsAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  expiresAt        DateTime
  lastSentAt       DateTime
  resendCount      Int                          @default(0)
  acceptedAt       DateTime?
  cancelledAt      DateTime?
  expiredAt        DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@index([organizationId, status])
  @@index([email, status])
  @@index([expiresAt])
  @@index([invitedByUserId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Event {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  producerId     String
  producer       User         @relation(fields: [producerId], references: [id])

  title        String
  description  String  @db.Text
  slug         String  @unique
  coverImage   String?
  bannerImage  String?
  spotifyUrl   String?
  instagramUrl String?

  venue     String
  address   String
  city      String
  state     String
  zipCode   String?
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  startDate DateTime
  endDate   DateTime
  doorsOpen DateTime?

  ageRating Int      @default(0)
  category  String?
  tags      String[] @default([])

  status               EventStatus @default(DRAFT)
  featured             Boolean     @default(false)
  allowTicketTransfers Boolean     @default(true)

  batches           Batch[]
  orders            Order[]
  checkIns          CheckIn[]
  tickets           Ticket[]
  coupons           Coupon[]
  ticketTransfers   TicketTransfer[]
  clubBenefitUsages ClubBenefitUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([organizationId])
  @@index([organizationId, status, startDate])
  @@index([producerId])
  @@index([status, startDate])
  @@index([featured, endDate])
  @@index([city, status])
}

model Batch {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  quantity    Int
  sold        Int     @default(0)

  startsAt DateTime
  endsAt   DateTime

  ticketType TicketType  @default(GENERAL)
  status     BatchStatus @default(ACTIVE)
  sortOrder  Int         @default(0)

  tickets           Ticket[]
  orderItems        OrderItem[]
  clubBenefitUsages ClubBenefitUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([eventId, status])
}

model Order {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  status OrderStatus @default(PENDING)

  subtotal    Decimal @db.Decimal(10, 2)
  platformFee Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  stripePaymentIntentId String? @unique
  stripeChargeId        String?
  paymentProvider       PaymentProvider @default(STRIPE)
  externalPaymentId     String?

  couponId       String?
  coupon         Coupon? @relation(fields: [couponId], references: [id])
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  clubBenefitReason String?

  cancelledAt    DateTime?
  cancelReason   String?
  refundedAt     DateTime?
  stripeRefundId String?
  refundId       String?
  refundFailureReason String?

  expiresAt DateTime

  items                 OrderItem[]
  tickets               Ticket[]
  reservedClubBenefits  ClubBenefitUsage[] @relation("ClubBenefitReservedOrder")
  confirmedClubBenefits ClubBenefitUsage[] @relation("ClubBenefitConfirmedOrder")
  refund                Refund?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([stripePaymentIntentId])
  @@index([expiresAt, status])
}

model Refund {
  id                String          @id @default(cuid())
  orderId           String          @unique
  order             Order           @relation(fields: [orderId], references: [id])
  userId            String
  gateway            PaymentProvider
  gatewayRefundId    String?
  amount             Decimal         @db.Decimal(10, 2)
  status             OrderStatus
  failureReason      String?
  ipAddress          String?
  requestedAt        DateTime         @default(now())
  completedAt        DateTime?
  updatedAt          DateTime         @updatedAt

  @@index([status, requestedAt])
  @@index([gateway, requestedAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])
  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
}

model Ticket {
  id          String @id @default(cuid())
  orderId     String
  order       Order  @relation(fields: [orderId], references: [id])
  batchId     String
  batch       Batch  @relation(fields: [batchId], references: [id])
  eventId     String
  event       Event  @relation(fields: [eventId], references: [id])
  ownerUserId String
  owner       User   @relation("TicketOwner", fields: [ownerUserId], references: [id])

  // Token criptograficamente aleatório — conteúdo do QR Code
  token String @unique @default(cuid())

  status TicketStatus @default(ACTIVE)

  holderName  String?
  holderEmail String?
  holderCpf   String?

  qrCodeUrl String?

  checkIn   CheckIn?
  transfers TicketTransfer[]
  history   TicketHistory[]
  clubBenefitUsage ClubBenefitUsage?

  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
  @@index([orderId])
  @@index([batchId])
  @@index([eventId, status])
  @@index([ownerUserId, status])
}

model TicketTransfer {
  id                   String               @id @default(cuid())
  ticketId             String
  ticket               Ticket               @relation(fields: [ticketId], references: [id])
  eventId              String
  event                Event                @relation(fields: [eventId], references: [id])
  senderUserId         String
  sender               User                 @relation("TransferSender", fields: [senderUserId], references: [id])
  recipientUserId      String?
  recipient            User?                @relation("TransferRecipient", fields: [recipientUserId], references: [id])
  recipientEmail       String
  status               TicketTransferStatus
  invitationTokenHash  String?              @unique
  requestedAt          DateTime             @default(now())
  completedAt          DateTime?
  cancelledAt          DateTime?
  expiresAt            DateTime?
  previousQrIdentifier String?
  newQrIdentifier      String?
  cancellationReason   String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  history TicketHistory[]

  @@index([ticketId, status])
  @@index([senderUserId, requestedAt])
  @@index([recipientUserId, requestedAt])
  @@index([recipientEmail])
  @@index([eventId, requestedAt])
}

model TicketHistory {
  id          String          @id @default(cuid())
  ticketId    String
  ticket      Ticket          @relation(fields: [ticketId], references: [id])
  transferId  String?
  transfer    TicketTransfer? @relation(fields: [transferId], references: [id])
  action      String
  actorUserId String?
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@index([ticketId, createdAt])
  @@index([transferId, createdAt])
}

model CheckIn {
  id       String @id @default(cuid())
  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id])
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id])

  staffId String?
  staff   User?   @relation("StaffCheckIns", fields: [staffId], references: [id])

  method CheckInMethod @default(QR_CODE)
  notes  String?

  checkedAt DateTime @default(now())

  @@index([eventId])
  @@index([ticketId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Transição expand/contract: novos registros usam apenas tokenHash.
  // token existe temporariamente para compatibilidade com o backend anterior.
  token     String?   @unique
  tokenHash String?   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Transição expand/contract: remover token apenas na fase de limpeza adiada.
  token     String?   @unique
  tokenHash String?   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model EmailOutbox {
  id                String            @id @default(cuid())
  type              String
  recipient         String
  subject           String
  template          String
  payload           Json
  relatedEntityType String?
  relatedEntityId   String?
  idempotencyKey    String            @unique
  status            EmailOutboxStatus @default(PENDING)
  attempts          Int               @default(0)
  maxAttempts       Int               @default(5)
  nextAttemptAt     DateTime          @default(now())
  providerMessageId String?
  lastError         String?
  processingAt      DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, nextAttemptAt])
  @@index([processingAt])
  @@index([relatedEntityType, relatedEntityId])
  @@index([createdAt])
}

model Coupon {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code      String
  discount  Decimal   @db.Decimal(5, 2)
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([eventId, code])
  @@index([eventId])
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model ClubMember {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String?
  phone              String?
  discountPercentage Decimal  @default(10.00) @db.Decimal(5, 2)
  isActive           Boolean  @default(true)
  activatedAt        DateTime @default(now())
  deactivatedAt      DateTime?

  usages ClubBenefitUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([phone])
  @@index([isActive])
}

model ClubBenefitUsage {
  id           String                 @id @default(cuid())
  clubMemberId String
  clubMember   ClubMember             @relation(fields: [clubMemberId], references: [id], onDelete: Restrict)
  eventId      String
  event        Event                  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  status       ClubBenefitUsageStatus @default(RESERVED)
  activeMarker Boolean?               @default(true)
  discountPercentage Decimal          @db.Decimal(5, 2)

  reservedOrderId  String? @unique
  reservedOrder    Order?  @relation("ClubBenefitReservedOrder", fields: [reservedOrderId], references: [id], onDelete: SetNull)
  confirmedOrderId String? @unique
  confirmedOrder   Order?  @relation("ClubBenefitConfirmedOrder", fields: [confirmedOrderId], references: [id], onDelete: SetNull)
  batchId          String?
  batch            Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  ticketId         String? @unique
  ticket           Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  originalAmount Decimal? @db.Decimal(10, 2)
  discountAmount Decimal? @db.Decimal(10, 2)
  finalAmount    Decimal? @db.Decimal(10, 2)

  reservedAt           DateTime?
  reservationExpiresAt DateTime?
  confirmedAt          DateTime?
  releasedAt           DateTime?
  releaseReason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubMemberId, eventId, activeMarker])
  @@index([clubMemberId, eventId])
  @@index([status, reservationExpiresAt])
  @@index([eventId, status])
}
