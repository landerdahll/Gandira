NODE_ENV=production
PORT=3001
APP_URL=https://seu-backend.onrender.com
FRONTEND_URL=https://pago.outrahora.com
# Temporário: dispensa verificação de e-mail e registra links de demonstração nos logs
DEMO_EMAIL_MODE=false

DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

JWT_SECRET=gere-uma-string-aleatoria-de-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=gere-outra-string-aleatoria-de-32-chars
JWT_REFRESH_EXPIRES_IN=7d

STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP — deixe em branco para logar links no console (dev mode)
# E-mail (somente backend/Render). Use um remetente de testes autorizado pelo
# Resend enquanto o domínio outrahora.com ainda não estiver verificado.
RESEND_API_KEY=
RESEND_FROM_NAME="Pago by OutraHora"
RESEND_FROM_EMAIL=onboarding@resend.dev
# Legado: RESEND_FROM ainda é aceito quando RESEND_FROM_EMAIL não existe.
# RESEND_FROM=
EMAIL_TOKEN_SECRET=
EMAIL_OUTBOX_POLL_INTERVAL_MS=45000
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_OUTBOX_PROCESSING_TIMEOUT_MS=600000

PLATFORM_FEE_PERCENT=10

THROTTLE_TTL=60
THROTTLE_LIMIT=30
